# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Model APIs ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Database ---
# When running Postgres via docker-compose, host is "localhost" from your machine
# and "db" from inside another compose service.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Models (keep EMBEDDING_DIM in sync with db/init.sql) ---
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
GENERATION_MODEL=claude-opus-4-8

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=8
RRF_K=60

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
